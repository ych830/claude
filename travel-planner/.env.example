APP_ENV=local
APP_NAME=Travel Planner API
APP_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/travel_app
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

LLM_API_KEY=change-me
LLM_MODEL=claude-sonnet-4-6

GOOGLE_MAPS_API_KEY=change-me
KAKAO_REST_API_KEY=change-me
KAKAO_CLIENT_ID=change-me
KAKAO_CLIENT_SECRET=change-me
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/kakao/callback
